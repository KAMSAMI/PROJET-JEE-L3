<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         id="WebApp_ID" version="4.0">
    
    <display-name>SuiviDonSangOrganes</display-name>
    
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Servlet pour la gestion des donneurs -->
    <servlet>
        <servlet-name>DonneurServlet</servlet-name>
        <servlet-class>com.donsang.servlet.DonneurServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DonneurServlet</servlet-name>
        <url-pattern>/donneur</url-pattern>
    </servlet-mapping>
    
    <!-- Servlet pour la gestion des receveurs -->
    <servlet>
        <servlet-name>ReceveurServlet</servlet-name>
        <servlet-class>com.donsang.servlet.ReceveurServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceveurServlet</servlet-name>
        <url-pattern>/receveur</url-pattern>
    </servlet-mapping>
    
    <!-- Servlet pour la gestion des dons -->
    <servlet>
        <servlet-name>DonServlet</servlet-name>
        <servlet-class>com.donsang.servlet.DonServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DonServlet</servlet-name>
        <url-pattern>/don</url-pattern>
    </servlet-mapping>
    
    <!-- Servlet pour le tableau de bord -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.donsang.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    
    <!-- Configuration de l'encodage UTF-8 -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.donsang.util.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <!-- Page d'erreur personnalisée -->
    <error-page>
        <error-code>404</error-code>
        <location>/pages/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/pages/error.jsp</location>
    </error-page>
    
</web-app>